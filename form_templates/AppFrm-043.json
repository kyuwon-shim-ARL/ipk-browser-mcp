{
  "form_code": "AppFrm-043",
  "form_name": "Seminar/Event Public Disclosure",
  "analysis_basis": "21 documents (talks, seminars, posters, journal submissions)",
  "fixed_fields": {
    "saving_years": "5 years",
    "predatory_check_confirmed": true,
    "section_6_text": "To promote responsible research activities, we have shared the Predatory Journals/Conferences Prevention Guide and the Pre-Participation Checklist via the groupware. Researchers participating in academic activities are required to use these materials to verify that the conference they plan to attend is not a predatory one"
  },
  "field_schema": {
    "subject": {
      "type": "text",
      "required": true,
      "source": "user_input",
      "dom_name": "subject",
      "note": "Title of the seminar/event/publication",
      "widget_type": "text"
    },
    "requester": {
      "type": "text",
      "required": true,
      "source": "profile",
      "dom_name": "requester",
      "dom_selector": ".validate[name=\"requester\"]",
      "dom_note": "input[name=\"requester\"]; also mirrored to .validate[name=\"requester\"]",
      "note": "Name of the person presenting/submitting (drafter by default)",
      "widget_type": "text"
    },
    "disclosure_purpose": {
      "type": "textarea",
      "required": true,
      "source": "user_input",
      "dom_name": "disclosure_purpose",
      "dom_selector": ".validate[name=\"purpose_field\"]",
      "dom_note": "textarea[name=\"disclosure_purpose\"]; also mirrored to .validate[name=\"purpose_field\"]",
      "note": "Section 1: Why the material is being publicly disclosed",
      "widget_type": "textarea"
    },
    "disclosure_date": {
      "type": "date",
      "required": true,
      "source": "user_input",
      "dom_name": "disclosure_date",
      "dom_selector": ".validate[name=\"disclosure_date\"]",
      "dom_note": "input[name=\"disclosure_date\"]; also mirrored to .validate[name=\"disclosure_date\"]",
      "note": "Section 2: Date of the seminar/event/submission",
      "widget_type": "date"
    },
    "material_description": {
      "type": "text",
      "required": true,
      "source": "user_input",
      "dom_name": "material_description",
      "dom_selector": ".validate[name=\"material_description\"]",
      "dom_note": "input[name=\"material_description\"]; also mirrored to .validate[name=\"material_description\"]",
      "note": "Section 3: Filename and size of the material (e.g. slides.pptx (12345678 byte))",
      "widget_type": "text"
    },
    "conference_or_journal": {
      "type": "text",
      "required": true,
      "source": "user_input",
      "dom_name": "conference_or_journal",
      "dom_selector": ".validate[name=\"conference_or_journal\"]",
      "dom_note": "input[name=\"conference_or_journal\"]; also mirrored to .validate[name=\"conference_or_journal\"]",
      "note": "Section 4: Name of the conference, seminar, or journal",
      "widget_type": "text"
    },
    "patent_filed": {
      "type": "radio",
      "required": false,
      "source": "user_input",
      "dom_name": "Q1",
      "dom_note": "radio input[name=\"Q1\"][value=\"Y/N\"] — set via frame.evaluate(); fallback selectors: input[name=\"radio_Q1\"], input[name=\"chk_Q1\"]",
      "values": [
        "Y",
        "N",
        ""
      ],
      "distribution": {
        "Y": 0.33,
        "N": 0.19,
        "not_answered": 0.48
      },
      "note": "Q1: Did you file a patent with the presenting material?",
      "widget_type": "radio"
    },
    "patent_planned_within_year": {
      "type": "radio",
      "required": false,
      "source": "user_input",
      "dom_name": "Q2",
      "dom_note": "radio input[name=\"Q2\"][value=\"Y/N\"] — set via frame.evaluate(); fallback selectors: input[name=\"radio_Q2\"], input[name=\"chk_Q2\"]",
      "values": [
        "Y",
        "N",
        ""
      ],
      "distribution": {
        "Y": 0.1,
        "N": 0.05,
        "not_answered": 0.86
      },
      "note": "Q2: Planning to file patent within a year? (only relevant if Q1=N)",
      "widget_type": "radio"
    },
    "material_published": {
      "type": "radio",
      "required": false,
      "source": "user_input",
      "dom_name": "Q3",
      "dom_note": "radio input[name=\"Q3\"][value=\"Y/N\"] — set via frame.evaluate(); fallback selectors: input[name=\"radio_Q3\"], input[name=\"chk_Q3\"]",
      "values": [
        "N",
        "Y",
        ""
      ],
      "distribution": {
        "N": 0.67,
        "Y": 0.19,
        "not_answered": 0.14
      },
      "note": "Q3: Is the presenting material published?",
      "widget_type": "radio"
    },
    "collaborator_approval_obtained": {
      "type": "radio",
      "required": false,
      "source": "user_input",
      "dom_name": "Q4",
      "dom_note": "radio input[name=\"Q4\"][value=\"Y/N\"] — set via frame.evaluate(); fallback selectors: input[name=\"radio_Q4\"], input[name=\"chk_Q4\"]",
      "values": [
        "Y",
        ""
      ],
      "distribution": {
        "Y": 0.76,
        "not_answered": 0.24
      },
      "note": "Q4: Got approval from collaborators? Most common answer: Y",
      "widget_type": "radio"
    },
    "contains_ipk_confidential_info": {
      "type": "radio",
      "required": false,
      "source": "user_input",
      "dom_name": "Q5",
      "dom_note": "radio input[name=\"Q5\"][value=\"Y/N\"] — set via frame.evaluate(); fallback selectors: input[name=\"radio_Q5\"], input[name=\"chk_Q5\"]",
      "values": [
        "N",
        ""
      ],
      "distribution": {
        "N": 0.67,
        "not_answered": 0.33
      },
      "note": "Q5: Does material contain IPK confidential info? Most common answer: N",
      "widget_type": "radio"
    }
  },
  "inference_rules": [
    {
      "description": "Predatory check always confirmed",
      "then_set": "check:chk410306",
      "to": "on",
      "note": "All 21 docs had this checked; it is a mandatory acknowledgment"
    },
    {
      "description": "Default Q4 collaborator approval",
      "if_field": "collaborator_approval_obtained",
      "is_empty": true,
      "then_set": "radio:Q4",
      "to": "Y",
      "note": "76% of docs answered Y; default to Y"
    },
    {
      "description": "Default Q5 confidential info",
      "if_field": "contains_ipk_confidential_info",
      "is_empty": true,
      "then_set": "radio:Q5",
      "to": "N",
      "note": "67% of docs answered N; default to N"
    },
    {
      "description": "Default Q3 material published",
      "if_field": "material_published",
      "is_empty": true,
      "then_set": "radio:Q3",
      "to": "N",
      "note": "67% of docs answered N; default to N"
    }
  ],
  "radio_field_map": {
    "patent_filed": "radio:Q1",
    "patent_planned_within_year": "radio:Q2",
    "material_published": "radio:Q3",
    "collaborator_approval_obtained": "radio:Q4",
    "contains_ipk_confidential_info": "radio:Q5"
  },
  "minimum_user_input": [
    "subject",
    "disclosure_purpose",
    "disclosure_date",
    "material_description",
    "conference_or_journal"
  ],
  "optional_user_input": [
    "patent_filed",
    "patent_planned_within_year",
    "material_published",
    "collaborator_approval_obtained",
    "contains_ipk_confidential_info"
  ]
}
