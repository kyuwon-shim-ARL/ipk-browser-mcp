{
  "form_code": "AppFrm-054",
  "form_name": "Domestic Travel Settlement",
  "url_pattern": "/Document/document_write.php?approve_type=AppFrm-054",
  "analysis_basis": "98 documents (49% conference/seminar, 42% vendor visit, 4% technical meeting, 3% training, 2% presentation)",
  "fixed_fields": {
    "retention": {
      "value": "5",
      "text": "5 years"
    },
    "travel_with_invitation": "No",
    "miscellaneous": 0,
    "additional_daily": 0
  },
  "field_schema": {
    "subject": {
      "type": "text",
      "dom_name": "subject",
      "required": true,
      "source": "user_input",
      "note": "Convention: '[Settlement] <original travel request subject>'",
      "widget_type": "text"
    },
    "start_date": {
      "type": "date",
      "dom_name": "start_date",
      "dom_note": "NOT a direct DOM input — comes from parent document via sel_travel hidden field",
      "required": true,
      "source": "user_input",
      "widget_type": "date"
    },
    "end_date": {
      "type": "date",
      "dom_name": "end_date",
      "dom_note": "NOT a direct DOM input — comes from parent document via sel_travel hidden field",
      "required": true,
      "source": "user_input",
      "widget_type": "date"
    },
    "start_time": {
      "type": "time",
      "dom_name": null,
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": false,
      "source": "user_input",
      "note": "Only for day-trips (nights=0). Present in 76% of docs."
    },
    "end_time": {
      "type": "time",
      "dom_name": null,
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": false,
      "source": "user_input",
      "note": "Only for day-trips (nights=0). Present in 76% of docs."
    },
    "purpose_category": {
      "type": "select",
      "dom_name": "purpose_category",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "inference",
      "values": [
        "Participation in the conference/seminar",
        "Simple visit to vendor & etc",
        "Technical meeting",
        "Training",
        "Post or Paper presentation"
      ],
      "distribution": {
        "Participation in the conference/seminar": 0.49,
        "Simple visit to vendor & etc": 0.42,
        "Technical meeting": 0.04,
        "Training": 0.03,
        "Post or Paper presentation": 0.02
      },
      "widget_type": "select"
    },
    "purpose": {
      "type": "textarea",
      "dom_name": "purpose",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "user_input",
      "note": "Free text detail matching the original travel request purpose",
      "widget_type": "textarea"
    },
    "destination": {
      "type": "text",
      "dom_name": "destination",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "user_input",
      "note": "Organization/venue name; copied or refined from original travel request",
      "widget_type": "text"
    },
    "province": {
      "type": "select",
      "dom_name": "province",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "inference",
      "note": "Part of cascading City & Transportation selector",
      "widget_type": "select"
    },
    "city": {
      "type": "select",
      "dom_name": "city",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "inference",
      "note": "Part of cascading City & Transportation selector",
      "widget_type": "select"
    },
    "transport_mode": {
      "type": "select",
      "dom_name": "transport_mode",
      "dom_note": "NOT a direct DOM input — comes from parent document",
      "required": true,
      "source": "inference",
      "values": [
        "Other Public Transporation",
        "Own Vehicle - Gasoline",
        "Own Vehicle - Diesel"
      ],
      "note": "Part of cascading City & Transportation selector",
      "widget_type": "select"
    },
    "budget_control_no": {
      "type": "hidden",
      "dom_name": "budget_control_no",
      "required": true,
      "source": "user_input",
      "note": "Must match the BC# from the corresponding approved travel request",
      "widget_type": "text"
    },
    "budget_type": {
      "type": "hidden",
      "dom_name": "budget_type",
      "required": true,
      "source": "inference",
      "values": [
        "R&D",
        "General"
      ],
      "distribution": {
        "R&D": 0.84,
        "General": 0.16
      },
      "widget_type": "text"
    },
    "daily_expense": {
      "type": "number",
      "dom_name": "daily_fee_total",
      "dom_fields": {
        "total": "daily_fee_total",
        "card": "daily_fee_card",
        "cash": "daily_fee_cash"
      },
      "required": true,
      "source": "inference",
      "note": "Per-day stipend. 20,000 for day-trips (nights=0); 30,000/day for overnight",
      "widget_type": "text"
    },
    "transport_fee": {
      "type": "number",
      "dom_name": "transport_fee_total",
      "dom_fields": {
        "total": "transport_fee_total",
        "card": "transport_fee_card",
        "cash": "transport_fee_cash"
      },
      "required": false,
      "source": "user_input",
      "note": "Actual transport receipts amount (train, bus, etc). Default 0.",
      "widget_type": "text"
    },
    "accommodation": {
      "type": "number",
      "dom_name": "accommodation_fee_total",
      "dom_fields": {
        "total": "accommodation_fee_total",
        "card": "accommodation_fee_card",
        "cash": "accommodation_fee_cash"
      },
      "required": false,
      "source": "user_input",
      "note": "Actual accommodation receipts amount. Default 0.",
      "widget_type": "text"
    },
    "food_expense": {
      "type": "number",
      "dom_name": "food_fee_total",
      "dom_fields": {
        "total": "food_fee_total",
        "card": "food_fee_card",
        "cash": "food_fee_cash"
      },
      "required": false,
      "source": "user_input",
      "note": "Actual food expense. Default 0.",
      "widget_type": "text"
    },
    "attached_approved_doc_ref": {
      "type": "text",
      "dom_name": "sel_travel",
      "dom_type": "hidden",
      "required": true,
      "source": "user_input",
      "note": "Doc number of the corresponding approved travel request (AppFrm-023); set via sel_travel hidden field",
      "widget_type": "text"
    }
  },
  "dom_fields": {
    "note": "Actual DOM input names in the settlement form (loaded from parent document via p_doc_id/sel_travel)",
    "hidden": [
      "budget_control_no",
      "budget_type",
      "sel_travel"
    ],
    "totals_structure": {
      "transport": {
        "total": "transport_fee_total",
        "card": "transport_fee_card",
        "cash": "transport_fee_cash"
      },
      "accommodation": {
        "total": "accommodation_fee_total",
        "card": "accommodation_fee_card",
        "cash": "accommodation_fee_cash"
      },
      "food": {
        "total": "food_fee_total",
        "card": "food_fee_card",
        "cash": "food_fee_cash"
      },
      "daily": {
        "total": "daily_fee_total",
        "card": "daily_fee_card",
        "cash": "daily_fee_cash"
      }
    },
    "own_vehicle": [
      "ocar_pay",
      "ocar_card_pay",
      "ocar_sum"
    ],
    "toll": [
      "toll_pay",
      "toll_card_pay",
      "toll_sum"
    ],
    "other": [
      "settle_amount",
      "piv",
      "food_yn",
      "food_ex_cnt"
    ]
  },
  "inference_rules": [
    {
      "description": "Subject auto-generation from original travel request subject",
      "then_set": "subject",
      "template": "[Settlement] {original_travel_request_subject}"
    },
    {
      "description": "Infer nights/days from date range",
      "then_set": "nights",
      "rule": "nights = (end_date - start_date).days; days = nights + 1"
    },
    {
      "description": "Daily expense from nights",
      "then_set": "daily_expense",
      "rule": "if nights == 0: 20000; if nights >= 1: 30000 per night",
      "values": {
        "day_trip (0 nights)": 20000,
        "overnight (per night)": 30000
      },
      "confidence": 0.97
    },
    {
      "description": "Purpose category from subject/purpose keywords",
      "then_set": "purpose_category",
      "rules": [
        {
          "keywords": [
            "conference",
            "symposium",
            "seminar",
            "workshop",
            "meeting",
            "forum"
          ],
          "value": "Participation in the conference/seminar",
          "confidence": 0.9
        },
        {
          "keywords": [
            "sampling",
            "collection",
            "visit",
            "survey",
            "vendor"
          ],
          "value": "Simple visit to vendor & etc",
          "confidence": 0.85
        },
        {
          "keywords": [
            "training",
            "교육"
          ],
          "value": "Training",
          "confidence": 0.9
        },
        {
          "keywords": [
            "presentation",
            "poster",
            "paper"
          ],
          "value": "Post or Paper presentation",
          "confidence": 0.85
        }
      ]
    },
    {
      "description": "Transport mode from province/city (matches AppFrm-023 logic)",
      "then_set": "transport_mode",
      "rules": [
        {
          "condition": "Seoul day-trip",
          "transport": "Other Public Transporation",
          "confidence": 0.66
        },
        {
          "condition": "Gyeonggi-do (Suwon)",
          "transport": "variable: Own Vehicle - Gasoline (67%) vs Other Public (33%)",
          "confidence": 0.67
        },
        {
          "condition": "Daejeon, Busan, Gangwon-do, out-of-metro",
          "transport": "Own Vehicle - Gasoline",
          "confidence": 0.82
        }
      ]
    },
    {
      "description": "Budget type from budget_account_code prefix",
      "then_set": "budget_type",
      "rule": "starts with 'R&D' -> R&D (84%); starts with 'General' -> General (16%)"
    }
  ],
  "ajax_cascade_sequence": [
    {
      "field": "province",
      "wait_selector": "select[name='city'] option:nth-child(2)",
      "timeout_ms": 3000,
      "note": "triggers city options (same as AppFrm-023)"
    },
    {
      "field": "city",
      "wait_selector": "select[name='transport_mode'] option:nth-child(2)",
      "timeout_ms": 3000,
      "note": "triggers transport_mode options"
    },
    {
      "field": "transport_mode",
      "timeout_ms": 1500
    },
    {
      "field": "budget_type",
      "wait_selector": "select[name='budget_code'] option:nth-child(2)",
      "timeout_ms": 3000,
      "note": "triggers budget_code options"
    },
    {
      "field": "budget_code",
      "wait_selector": "select[name='item_no'] option:nth-child(2)",
      "timeout_ms": 3000,
      "condition": "budget_type",
      "note": "triggers item_no options; only if budget_type set"
    },
    {
      "field": "item_no",
      "timeout_ms": 1500,
      "condition": "budget_code"
    }
  ],
