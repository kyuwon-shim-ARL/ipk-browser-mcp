# Credentials - NEVER commit these
.env
.credentials
config.json
*.token.json

# Screenshots (may contain sensitive info)
screenshots/

# Python
__pycache__/
*.pyc
.venv/

# Node.js
node_modules/

# Dist (ignore root-level, but keep ipk-browser-mcp/dist/ for plugin distribution)
/dist/
!ipk-browser-mcp/dist/

# Sourcemaps - dev-only (set DEV=true when building to generate)
ipk-browser-mcp/dist/*.mjs.map

# OMC state (session-specific, not project data)
.omc/
.history.json

# Claude Code
.claude/*
!.claude/settings.json

# IDE
.idea/
.vscode/

# Personal input data
input/

# OS
.DS_Store
Thumbs.db
.gstack/

# Per-field rulebooks hold full corporate card numbers and doc_ids; repo is public
form_rules/
